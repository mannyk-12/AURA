rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    // Replace 'YOUR_EMAIL@gmail.com' with your actual admin email address
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "manojkms411223@gmail.com";
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Default deny all read/write access
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------------------------
    // USERS COLLECTION
    // ----------------------------------------------------------------------
    match /users/{userId} {
      // Students can read their own profile, Admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();
      
      // Students can ONLY create their profile or update specific fields (like onboarding).
      // They cannot delete it or alter protected fields later. Admins can do anything.
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      
      // CHAT HISTORY SUBCOLLECTION
      match /chatHistory/{chatId} {
        // Only the owner of the chat or an admin can access/modify the chat history
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      // NOTIFICATIONS SUBCOLLECTION
      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        // Only the backend/admin can create notifications, users can only update (e.g. mark as read)
        allow create, delete: if isAdmin();
        allow update: if isOwner(userId) || isAdmin();
      }
    }

    // ----------------------------------------------------------------------
    // CAMPUS DATA COLLECTIONS (Events, etc)
    // ----------------------------------------------------------------------
    match /campus/{document=**} {
      // Anyone who is logged in can view campus data (events, menu, etc)
      allow read: if request.auth != null;
      // Only the admin or backend functions can modify campus data
      allow write: if isAdmin();
    }
  }
}
